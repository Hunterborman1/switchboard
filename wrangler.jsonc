{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invoca-signal-loop",
  "account_id": "b33453696f318f27ad9c4036bd3f089d",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // A path route under repos.hunterborman.com, like every other repo on the host. No
  // workers.dev or preview URL: either would be a second, ungated door onto the build.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "repos.hunterborman.com/repo/invoca", "zone_name": "hunterborman.com" },
    { "pattern": "repos.hunterborman.com/repo/invoca/*", "zone_name": "hunterborman.com" }
  ],

  // run_worker_first: the Worker authorises and strips /repo/invoca before any asset is
  // served. Assets served ahead of the Worker would bypass the gate.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "invoca-signal-loop", "database_id": "a1500102-37e1-485c-9287-12eb0ec22afb", "migrations_dir": "migrations" },
    { "binding": "PLATFORM_DB", "database_name": "invoca-agent-ops", "database_id": "35b74275-27f6-47ac-83b8-e6d548b94066", "migrations_dir": "migrations-platform" }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "a9e5f55e3f7e41ec82af029a0bf3ca1c" }],
  "vectorize": [{ "binding": "VECTORS", "index_name": "invoca-signal-loop" }],
  "ai": { "binding": "AI" },

  "workflows": [{ "name": "signal-loop-pipeline", "binding": "PIPELINE", "class_name": "PipelineWorkflow" }],

  // Abuse limits (fail closed): run creation per workspace and per client IP, and password /
  // owner-token attempts per IP. The $15 budget ledger is the hard stop on spend.
  "ratelimits": [
    { "name": "RL_RUNS", "namespace_id": "4201", "simple": { "limit": 12, "period": 60 } },
    { "name": "RL_RUNS_IP", "namespace_id": "4202", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_UNLOCK", "namespace_id": "4203", "simple": { "limit": 10, "period": 60 } }
  ],

  "vars": {
    "MODEL_PRIMARY": "deepseek/deepseek-v4.1-flash",
    "MODEL_SECONDARY": "anthropic/claude-haiku-5.5",
    // Triage and the second opinion at the gate (docs/reports/decision-models.md).
    "MODEL_DECISION": "z-ai/glm-5.3-flash",
    "BUDGET_LIMIT_USD": "15"
  },

  "observability": { "enabled": true }

  // Secrets (scripts/deploy.ts pushes them from .env):
  //   INVOCA_PASSWORD, LINK_SIGNING_SECRET, OWNER_TOKEN (owner session), OPENROUTER_API_KEY (the $15 runtime key)
}
