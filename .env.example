# Copy to .env (git-ignored). Scripts read it through scripts/env.ts; `npm run dev:vars`
# writes .dev.vars for `wrangler dev` from it. Never commit real values.

# Access to the deployed app
INVOCA_PASSWORD=            # viewer password
LINK_SIGNING_SECRET=        # signs links, workspace cookies and MCP tokens (32+ random bytes)
OWNER_TOKEN=                # owner session secret; scripts/env.ts generates one if missing

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_RUNTIME_KEY=     # the deployed Worker's key (hard spend limit set at OpenRouter)
OPENROUTER_BUILD_KEY=       # local dev, evals, data generation, speed tests
OPENROUTER_MANAGEMENT_KEY=  # optional: creates and limits the two keys above

# Cloudflare (API token with Workers, D1, KV, Vectorize and Workflows edit)
CLOUDFLARE_WRITE_ACCOUNT_ID=
CLOUDFLARE_WRITE_API_KEY=
CLOUDFLARE_ZONE_ID=
