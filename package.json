{
  "name": "switchboard",
  "version": "1.0.0",
  "description": "Switchboard: any conversation in, the right people out. Signal Loop (product feedback) and Agent Ops. Invoca AI Operations Lead take-home.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8797",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply invoca-signal-loop --local",
    "deploy": "node scripts/deploy.ts",
    "sign-link": "node scripts/sign-link.ts",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "dev:vars": "node scripts/lib/dev-vars.ts",
    "db:seed:local": "node scripts/seed.ts --local",
    "db:seed:remote": "node scripts/seed.ts --remote",
    "db:seed:platform:local": "node scripts/platform/seed.ts --local",
    "db:seed:platform:remote": "node scripts/platform/seed.ts --remote",
    "backfill": "node --env-file=.env scripts/backfill.ts",
    "replays:record": "node --env-file=.env scripts/record-replays.ts",
    "eval": "node --env-file=.env scripts/eval.ts",
    "verify:data": "node --env-file=.env scripts/verify-data.ts",
    "e2e:local": "node scripts/lib/e2e-local.ts"
  },
  "type": "module",
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.153",
    "fastest-levenshtein": "^1.0.16",
    "fflate": "0.8.3",
    "hono": "^4.13.13",
    "motion": "^14.6.0",
    "pdfjs-dist": "6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
